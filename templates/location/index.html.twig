
{% extends 'base.html.twig' %}

{% block title %}Location index{% endblock %}

{% block body %}
    <h1>Location index</h1>

    <div class="table-responsive">
        <table class="table">
            <thead>
            <tr>
                <th class="d-none d-md-table-cell">Id</th>
                <th>City</th>
                <th>Country</th>
                <th class="d-none d-md-table-cell">Latitude</th>
                <th class="d-none d-md-table-cell">Longtitude</th>
                <th>actions</th>
            </tr>
            </thead>
            <tbody>
            {% for location in locations %}
                <tr>
                    <td class="d-none d-md-table-cell">{{ location.id }}</td>
                    <td>{{ location.city }}</td>
                    <td>{{ location.country }}</td>
                    <td class="d-none d-md-table-cell">{{ location.latitude }}</td>
                    <td class="d-none d-md-table-cell">{{ location.longtitude }}</td>
                    <td>
                        <a href="{{ path('app_location_show', {'id': location.id}) }}">show</a>
                        <a href="{{ path('app_location_edit', {'id': location.id}) }}">edit</a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6">no records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>

    <a href="{{ path('app_location_new') }}">Create new</a>
{% endblock %}
